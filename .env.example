PORT=5000
NODE_ENV=development
DB_URL=mongodb://127.0.0.1:27017/campus_lost_found
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_EXPIRES_IN=1d
COOKIE_SECURE=false
CAMPUS_EMAIL_DOMAIN=yourcollege.edu.in
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_MS=60000
VECTOR_SEARCH_ENABLED=false
REPORT_VECTOR_INDEX=report_embedding_index
POLICY_VECTOR_INDEX=policy_chunk_index
PUBLIC_ITEM_LIMIT=30
